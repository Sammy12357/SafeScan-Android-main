EXPO_PUBLIC_API_BASE_URL=https://safescan-qr.onrender.com

# Google OAuth (Web ID is reused as the Auth0 connection client_id)
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=230684501873-4aauu1triudaaopdcus2k7achvesr3el.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# Auth0 — pick values up from env so the public client_id is rotatable
# without a code change. Defaults baked in match the legacy dev tenant.
EXPO_PUBLIC_AUTH0_DOMAIN=
EXPO_PUBLIC_AUTH0_CLIENT_ID=
EXPO_PUBLIC_EXPO_PROXY_USERNAME=fellowbeast
EXPO_PUBLIC_EXPO_PROXY_SLUG=safescan-android

# NOTE: admin role is determined SERVER-SIDE. The client never reads an admin
# allowlist — the backend must populate User.role and re-authorize on every
# privileged endpoint. Do not re-introduce an EXPO_PUBLIC_ADMIN_EMAILS list:
# anything prefixed EXPO_PUBLIC_ ships in the JS bundle and helps phishing.

APP_ENV=development
